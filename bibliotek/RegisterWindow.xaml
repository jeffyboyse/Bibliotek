<Window x:Class="bibliotek.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bibliotek"
        mc:Ignorable="d"
        Title="Bibliotekssytem - Registrera" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Skapa konto" FontSize="22" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Förnamn -->
            <TextBlock Text="Förnamn:" Margin="0,5,0,2"/>
            <TextBox x:Name="txtFirstName" Height="30" VerticalContentAlignment="Center" Padding="5"/>

            <!-- Efternamn -->
            <TextBlock Text="Efternamn:" Margin="0,10,0,2"/>
            <TextBox x:Name="txtLastName" Height="30" VerticalContentAlignment="Center" Padding="5"/>

            <!-- E-post -->
            <TextBlock Text="E-postadress:" Margin="0,10,0,2"/>
            <TextBox x:Name="txtEmail" Height="30" VerticalContentAlignment="Center" Padding="5"/>

            <!-- Lösenord -->
            <TextBlock Text="Lösenord:" Margin="0,10,0,2"/>
            <PasswordBox x:Name="txtPassword" Height="30" VerticalContentAlignment="Center" Padding="5"/>

            <!-- Statusmeddelande -->
            <TextBlock x:Name="lblMessage" Foreground="Red" Margin="0,10,0,0" 
                       TextWrapping="Wrap" HorizontalAlignment="Center"/>

            <!-- Registrera-knapp -->
            <Button x:Name="btnRegister" Content="Skapa konto" Height="35" Margin="0,15,0,0" 
                    Background="#28A745" Foreground="White" FontWeight="Bold" 
                    Click="BtnRegister_Click"/>

        </StackPanel>
    </Grid>
</Window>
