<Window x:Class="bibliotek.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adminpanel — Bibliotekssystem" Height="450" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="lblWelcome" 
                       Text="Välkommen till Adminpanelen!" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20" 
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Här kan du hantera användare, böcker och utlåningar." 
                       FontSize="14" 
                       Margin="0,0,0,30" 
                       HorizontalAlignment="Center"/>

            <Button x:Name="btnLogout" 
                    Content="Logga ut" 
                    Width="120" 
                    Height="35" 
                    Click="BtnLogout_Click" 
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>