<Window x:Class="bibliotek.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stina-Lib — Administrationspanel (CMS)" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOPHEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <Button Content="Stäng / Tillbaka" Width="120" Height="30" DockPanel.Dock="Right" Click="BtnClose_Click" Background="#ECEFF1"/>
            <TextBlock x:Name="lblAdminHeader" Text="⚙️ Administrationspanel" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- CMS TAB-CONTROL -->
        <TabControl Grid.Row="1">

            <!-- FLIK 1: HANTERA MEDIA & EAV-ATTRIBUT -->
            <TabItem Header="📖 Media &amp; EAV-Attribut">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <!-- Huvudtabell Media -->
                        <GroupBox Header="Media" Grid.Row="0" Margin="0,0,0,5">
                            <DataGrid x:Name="dgMedia" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="DgMedia_SelectionChanged"/>
                        </GroupBox>

                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#CCC"/>

                        <!-- EAV-attribut för markerat media -->
                        <GroupBox Header="Kopplade EAV-attribut för valt Media" Grid.Row="2" Margin="0,5,0,0">
                            <DataGrid x:Name="dgMediaAttributes" AutoGenerateColumns="True" IsReadOnly="True"/>
                        </GroupBox>
                    </Grid>

                    <!-- SIDOPANEL FÖR EAV-HANTERING -->
                    <ScrollViewer Grid.Column="1">
                        <StackPanel>
                            <!-- LÄGG TILL EAV ATTRIBUT -->
                            <Border Background="#F9F9F9" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Koppla EAV-Attribut" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                                    <TextBlock Text="Valt Media ID:"/>
                                    <TextBox x:Name="txtSelectedMediaId" IsReadOnly="True" Background="#E0E0E0" Margin="0,0,0,8"/>

                                    <TextBlock Text="Välj Attribut (T.ex. Speltid/Språk):"/>
                                    <ComboBox x:Name="cmbAttributes" DisplayMemberPath="Name" SelectedValuePath="AttributeID" Margin="0,0,0,8"/>

                                    <TextBlock Text="Värde (t.ex. Engelska / 02:27:00):"/>
                                    <TextBox x:Name="txtAttributeValue" Margin="0,0,0,12"/>

                                    <Button Content="Spara/Uppdatera Attribut" Background="#1976D2" Foreground="White" FontWeight="Bold" Height="30" Click="BtnSaveAttribute_Click" Margin="0,0,0,5"/>
                                    <Button Content="Ta bort valt attribut" Background="#D32F2F" Foreground="White" Height="30" Click="BtnDeleteAttribute_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- SKAPA ETT HELT NYTT MEDIA -->
                            <Border Background="#F9F9F9" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Skapa nytt Media" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                                    <TextBlock Text="Titel:"/>
                                    <TextBox x:Name="txtTitle" Margin="0,0,0,8"/>

                                    <TextBlock Text="Mediatyp:"/>
                                    <ComboBox x:Name="cmbMediaType" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Bok"/>
                                        <ComboBoxItem Content="Ljudbok"/>
                                        <ComboBoxItem Content="Film"/>
                                    </ComboBox>

                                    <Button Content="Skapa Media" Background="#388E3C" Foreground="White" FontWeight="Bold" Height="30" Click="BtnSaveMedia_Click" Margin="0,0,0,5"/>
                                    <Button Content="Ta bort markerat Media" Background="#D32F2F" Foreground="White" Height="30" Click="BtnDeleteMedia_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- FLIK 2: KOPIOR / EXEMPLAR -->
            <TabItem Header="🏷️ Exemplar &amp; Streckkoder">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="dgCopies" Grid.Column="0" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,0,10,0"/>
                    <Border Grid.Column="1" Background="#F9F9F9" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Skapa ny kopia" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Text="Media ID:"/>
                            <TextBox x:Name="txtCopyMediaId" Margin="0,0,0,8"/>
                            <TextBlock Text="Streckkod (Unikt ID):"/>
                            <TextBox x:Name="txtBarcode" Margin="0,0,0,15"/>
                            <Button Content="Skapa Kopia" Background="#1976D2" Foreground="White" FontWeight="Bold" Height="30" Click="BtnCreateCopy_Click" Margin="0,0,0,5"/>
                            <Button Content="Ta bort Kopia" Background="#D32F2F" Foreground="White" Height="30" Click="BtnDeleteCopy_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- FLIK 3: ANVÄNDARE -->
            <TabItem Header="👥 Användare">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="dgUsers" Grid.Column="0" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,0,10,0"/>
                    <Border Grid.Column="1" Background="#F9F9F9" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Skapa Användare" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Text="Förnamn:"/>
                            <TextBox x:Name="txtFirstName" Margin="0,0,0,8"/>
                            <TextBlock Text="Efternamn:"/>
                            <TextBox x:Name="txtLastName" Margin="0,0,0,8"/>
                            <TextBlock Text="E-post:"/>
                            <TextBox x:Name="txtUserEmail" Margin="0,0,0,8"/>
                            <CheckBox x:Name="chkIsAdmin" Content="Administratör (Role)" Margin="0,0,0,15"/>
                            <Button Content="Spara Användare" Background="#1976D2" Foreground="White" FontWeight="Bold" Height="30" Click="BtnSaveUser_Click" Margin="0,0,0,5"/>
                            <Button Content="Ta bort Användare" Background="#D32F2F" Foreground="White" Height="30" Click="BtnDeleteUser_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- FLIK 4: LÅN OCH FÖRSENINGAR -->
            <TabItem Header="📋 Utlånade &amp; Försenade Kopior">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="dgActiveLoans" Grid.Row="0" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,0,0,10"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Kontrollera försenade &amp; Generera fakturor (1.5x)" Background="#D32F2F" Foreground="White" FontWeight="Bold" Padding="12,8" Click="BtnCheckOverdue_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>