<Window x:Class="bibliotek.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stina-Lib — Administrationspanel (CMS)" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <TabControl x:Name="AdminTabs">

            <!-- TAB 1: MEDIA & KOPIOR -->
            <TabItem Header="Media &amp; Kopior">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- VÄNSTER: Listvy över Media -->
                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Registrerat Media" FontSize="16" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                        <DataGrid x:Name="dgMedia" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  SelectionChanged="DgMedia_SelectionChanged"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding MediaID}" Width="40"/>
                                <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Typ" Binding="{Binding MediaType}" Width="90"/>
                                <DataGridTextColumn Header="SAB" Binding="{Binding SabCode}" Width="60"/>
                                <DataGridTextColumn Header="Värde (kr)" Binding="{Binding Price, StringFormat={}{0:C0}}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- HÖGER: Formulär för Skapa/Redigera/Radera Media -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Hantera Vald / Ny Media" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                            <TextBlock Text="Titel:" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtTitle" Height="25"/>

                            <TextBlock Text="Mediatyp (Bok / Ljudbok / Film):" Margin="0,5,0,2"/>
                            <ComboBox x:Name="cmbMediaType" Height="25">
                                <ComboBoxItem Content="Bok"/>
                                <ComboBoxItem Content="Ljudbok"/>
                                <ComboBoxItem Content="Film"/>
                            </ComboBox>

                            <TextBlock Text="ISBN / EAN:" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtIsbn" Height="25"/>

                            <TextBlock Text="SAB-Kod (t.ex. Hc, F):" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtSab" Height="25"/>

                            <TextBlock Text="Inköps-/Ersättningsvärde (kr):" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtPrice" Height="25"/>

                            <!-- Knappar för Media CRUD -->
                            <StackPanel Orientation="Horizontal" Margin="0,15,0,15" HorizontalAlignment="Right">
                                <Button Content="Spara Ny" Click="BtnSaveMedia_Click" Width="85" Height="28" Margin="0,0,5,0"/>
                                <Button Content="Uppdatera" Click="BtnUpdateMedia_Click" Width="85" Height="28" Margin="0,0,5,0"/>
                                <Button Content="Ta bort" Click="BtnDeleteMedia_Click" Width="85" Height="28" Background="#FFDDDD"/>
                            </StackPanel>

                            <Separator Margin="0,10"/>

                            <!-- Sektion för Exemparkopior -->
                            <TextBlock Text="Exemplar / Kopior" FontSize="14" FontWeight="Bold" Margin="0,5,0,5"/>
                            <Button Content="+ Lägg till ny kopia (Generera streckkod)" Click="BtnAddCopy_Click" Height="28" Margin="0,0,0,10"/>

                            <DataGrid x:Name="dgCopies" AutoGenerateColumns="False" IsReadOnly="True" Height="150">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Streckkod" Binding="{Binding Barcode}" Width="*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 2: ANVÄNDARE -->
            <TabItem Header="Användare">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Registrerade Användare" FontSize="16" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                        <DataGrid x:Name="dgUsers" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgUsers_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding User_ID}" Width="40"/>
                                <DataGridTextColumn Header="Namn" Binding="{Binding FirstName}" Width="100"/>
                                <DataGridTextColumn Header="Efternamn" Binding="{Binding LastName}" Width="100"/>
                                <DataGridTextColumn Header="E-post" Binding="{Binding Email}" Width="*"/>
                                <DataGridCheckBoxColumn Header="Admin" Binding="{Binding Role}" Width="50"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Hantera Användare" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Text="Förnamn:" Margin="0,5,0,2"/>
                        <TextBox x:Name="txtUserFirstName" Height="25"/>

                        <TextBlock Text="Efternamn:" Margin="0,5,0,2"/>
                        <TextBox x:Name="txtUserLastName" Height="25"/>

                        <TextBlock Text="E-post:" Margin="0,5,0,2"/>
                        <TextBox x:Name="txtUserEmail" Height="25"/>

                        <TextBlock Text="Lösenord:" Margin="0,5,0,2"/>
                        <TextBox x:Name="txtUserPassword" Height="25"/>

                        <CheckBox x:Name="chkIsAdmin" Content="Administratör" Margin="0,10,0,15"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Spara Ny" Click="BtnSaveUser_Click" Width="85" Height="28" Margin="0,0,5,0"/>
                            <Button Content="Uppdatera" Click="BtnUpdateUser_Click" Width="85" Height="28" Margin="0,0,5,0"/>
                            <Button Content="Ta bort" Click="BtnDeleteUser_Click" Width="85" Height="28" Background="#FFDDDD"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: LÅN & FÖRSENINGAR / FAKTURUNDERLAG -->
            <TabItem Header="Lån &amp; Fakturaunderlag">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Översikt över alla lån" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="Visa endast försenade lån" Click="BtnFilterOverdue_Click" Margin="20,0,0,0" Padding="10,4"/>
                        <Button Content="Visa alla lån" Click="BtnShowAllLoans_Click" Margin="10,0,0,0" Padding="10,4"/>
                    </StackPanel>

                    <DataGrid x:Name="dgLoans" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Låne-ID" Binding="{Binding LoanID}" Width="60"/>
                            <DataGridTextColumn Header="Låntagare" Binding="{Binding BorrowerName}" Width="140"/>
                            <DataGridTextColumn Header="Titel" Binding="{Binding MediaTitle}" Width="*"/>
                            <DataGridTextColumn Header="Streckkod" Binding="{Binding Barcode}" Width="110"/>
                            <DataGridTextColumn Header="Lånedatum" Binding="{Binding LoanDate, StringFormat={}{0:yyyy-MM-dd}}" Width="90"/>
                            <DataGridTextColumn Header="Förfallodatum" Binding="{Binding DueDate, StringFormat={}{0:yyyy-MM-dd}}" Width="90"/>
                            <DataGridTextColumn Header="Förseningsavgift (1.5x)" Binding="{Binding InvoiceAmount, StringFormat={}{0:C0}}" Width="140"/>
                            <DataGridTemplateColumn Header="Åtgärd" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Avskriv &amp; Fakturera" Click="BtnInvoiceAndWriteOff_Click" IsEnabled="{Binding IsOverdue}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>