<Window x:Class="bibliotek.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bibliotek"
        mc:Ignorable="d"
        Title="Biblioteksystem - Logga in" Height="350" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Välkommen" FontSize="22" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- E-post -->
            <TextBlock Text="E-postadress:" Margin="0,5,0,2"/>
            <TextBox x:Name="txtEmail" Height="30" VerticalContentAlignment="Center" Padding="5"/>

            <!-- Lösenord -->
            <TextBlock Text="Lösenord:" Margin="0,10,0,2"/>
            <PasswordBox x:Name="txtPassword" Height="30" VerticalContentAlignment="Center" Padding="5"/>

            <!-- Status/Felmeddelande -->
            <TextBlock x:Name="lblMessage" Foreground="Red" Margin="0,10,0,0" 
                       TextWrapping="Wrap" HorizontalAlignment="Center"/>

            <!-- Logga in-knapp -->
            <Button x:Name="btnLogin" Content="Logga in" Height="35" Margin="0,20,0,0" 
                    Background="#007ACC" Foreground="White" FontWeight="Bold" 
                    Click="BtnLogin_Click"/>

        </StackPanel>

    </Grid>
</Window>
