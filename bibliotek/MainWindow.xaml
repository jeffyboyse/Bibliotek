<Window x:Class="bibliotek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stina-Lib — Bibliotekssystem" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        
        <Button x:Name="BtnOpenLogin" 
        Content="Logga in" 
        HorizontalAlignment="Right" 
        VerticalAlignment="Top" 
        Margin="0,10,10,0" 
        Padding="10,5" 
        Click="BtnOpenLogin_Click"/>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header / Sökfält -->
            <RowDefinition Height="*"/>
            <!-- Kort/Resultatvy -->
        </Grid.RowDefinitions>

        <!-- SÖKSEKTION LÄNGST UPP -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBox x:Name="txtSearch" Width="350" Height="32" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
                <Button Content="Sök" Width="90" Height="32" FontWeight="Bold" Click="BtnSearch_Click"/>
            </StackPanel>

            <Button Content="Öppna Admin (CMS)" Click="BtnAdmin_Click" DockPanel.Dock="Right" Width="140" Height="32" Background="#ECEFF1"/>
        </DockPanel>

        <!-- KORTVISNING FÖR SÖKRESULTAT -->
        <ListBox x:Name="lbSearchResults" 
                 Grid.Row="1" 
                 BorderThickness="0" 
                 Background="Transparent"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,15"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Enskilt produktkort -->
                    <Border Background="White" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#20000000"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <!-- Bokomslag / Ikon -->
                                <ColumnDefinition Width="*"/>
                                <!-- Information & Knapp -->
                            </Grid.ColumnDefinitions>

                            <!-- Vänster: Placeholder för bokomslag / Bild -->
                            <Border Grid.Column="0" 
                                    Width="90" 
                                    Height="120" 
                                    Background="#F5F5F5" 
                                    CornerRadius="4" 
                                    BorderBrush="#DDD"
                                    BorderThickness="1"
                                    VerticalAlignment="Top">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="📖" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding MediaType}" FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Höger: Detaljerad information -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="15,0,0,0">
                                <!-- Titel (klickbar) -->
                                <TextBlock Text="{Binding Title}" 
                                           FontSize="20" 
                                           FontWeight="Bold" 
                                           Foreground="#005A9C" 
                                           Cursor="Hand" 
                                           MouseDown="LblTitle_MouseDown"
                                           Tag="{Binding}"/>

                                <TextBlock Text="{Binding AuthorOrDirector, StringFormat='av {0}'}" 
                                           FontSize="14" 
                                           Foreground="#333" 
                                           Margin="0,4,0,10"/>

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                    <TextBlock Text="Mediatyp: " FontWeight="SemiBold" Foreground="#555"/>
                                    <TextBlock Text="{Binding MediaType}" Foreground="#555"/>
                                    <TextBlock Text="  |  Utgivningsår: " FontWeight="SemiBold" Foreground="#555"/>
                                    <TextBlock Text="{Binding PublishYear}" Foreground="#555"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                                    <TextBlock Text="SAB-Kod: " FontWeight="SemiBold" Foreground="#555"/>
                                    <TextBlock Text="{Binding SabCode}" Foreground="#555"/>
                                    <TextBlock Text="  |  ISBN/EAN: " FontWeight="SemiBold" Foreground="#555"/>
                                    <TextBlock Text="{Binding IsbnOrEan}" Foreground="#555"/>
                                </StackPanel>

                                <!-- Knapp för att öppna produktsidan (ProductView) -->
                                <Button Content="Visa tillgänglighet / Produktsida" 
                                        Background="#2E7D32" 
                                        Foreground="White" 
                                        FontWeight="Bold" 
                                        Padding="12,6" 
                                        HorizontalAlignment="Left" 
                                        Cursor="Hand"
                                        Click="BtnOpenProduct_Click" 
                                        Tag="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>